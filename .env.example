# Copy to .env once and edit it; do not overwrite an existing deployment's .env.
# Persist the host model path so Compose also works in a fresh SSH session.
ARGUS_MODEL_DIR_HOST=/opt/argus/models/v4

# Match both values in Ingressi's .env. Custom socket paths must stay in /run/argus.
ARGUS_SOCKET_VOLUME=ingressi-argus-run
ARGUS_SOCKET=/run/argus/argus.sock
ARGUS_SOCKET_MODE=0o660

ARGUS_VERIFY_MANIFEST=1
ARGUS_THRESHOLD=fpr0.1%
ARGUS_WORKERS=4
ARGUS_MAX_CONCURRENT_RPCS=8
ARGUS_MIN_REMAINING_MS=5
ORT_INTRA_THREADS=1
ARGUS_LOG_LEVEL=INFO
